FROM alpine:3.20

RUN apk add --no-cache openssh-server bash coreutils netcat-openbsd procps && \
    adduser -D -s /bin/bash testuser && \
    passwd -u testuser && \
    mkdir -p /home/testuser/.ssh /opt/piper-e2e-app /var/log/piper-e2e

# Pinned host keys come from the fixture so the container fingerprint is stable
# across rebuilds. Generated by scripts/e2e-setup.sh; gitignored.
COPY host-keys/ssh_host_ed25519_key /etc/ssh/ssh_host_ed25519_key
COPY host-keys/ssh_host_ed25519_key.pub /etc/ssh/ssh_host_ed25519_key.pub
COPY host-keys/ssh_host_rsa_key /etc/ssh/ssh_host_rsa_key
COPY host-keys/ssh_host_rsa_key.pub /etc/ssh/ssh_host_rsa_key.pub
RUN chmod 600 /etc/ssh/ssh_host_ed25519_key /etc/ssh/ssh_host_rsa_key && \
    chmod 644 /etc/ssh/ssh_host_ed25519_key.pub /etc/ssh/ssh_host_rsa_key.pub

COPY keys/piper-e2e-test.pub /home/testuser/.ssh/authorized_keys
COPY test-content/ /opt/piper-e2e-app/
COPY test-content/app.log /var/log/piper-e2e/app.log

RUN chown -R testuser:testuser /home/testuser/.ssh /opt/piper-e2e-app /var/log/piper-e2e && \
    chmod 700 /home/testuser/.ssh && \
    chmod 600 /home/testuser/.ssh/authorized_keys && \
    sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -i 's/^#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/^#AllowAgentForwarding.*/AllowAgentForwarding no/' /etc/ssh/sshd_config && \
    sed -i 's/^#X11Forwarding.*/X11Forwarding no/' /etc/ssh/sshd_config

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
