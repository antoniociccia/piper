#!/usr/bin/env bash
# ============================================================================
# piper-docker-shim — DEMO STUB ONLY. NOT DOCKER.
# ============================================================================
#
# This script is a static-output emulator that mimics the SHAPE of `docker`'s
# subcommands (`ps`, `logs`, `inspect`, `compose ps/config/up/restart/down`)
# so PIPER can be demonstrated against a host that "looks like" a Docker-based
# deployment without bringing up a real Docker daemon inside the demo
# container. Like a real production socket, it refuses non-root callers — so
# PIPER's reactive-sudo flow has a realistic permission boundary to hit.
#
# It does NOT contain any Docker source code, does NOT manage any containers,
# does NOT exec any Docker engine. It prints fabricated, hard-coded strings.
# Coverage is ~50 lines per subcommand.
#
# "Docker" and the Docker whale logo are trademarks of Docker, Inc.
# This shim does NOT use the Docker name or logo as marketing or branding —
# the file name is "piper-docker-shim". The shim is installed in the demo
# container at /usr/local/bin/piper-docker-shim with a symlink at
# /usr/local/bin/docker so PIPER's catalog (which invokes `docker ps` etc.)
# resolves correctly. This is a nominative-fair-use shim for compatibility,
# not an emulation of Docker functionality or behaviour beyond surface text.
#
# If you are looking for the real Docker, see https://www.docker.com/.
#
# License: Apache-2.0 (part of the PIPER repository).
# ============================================================================
#
# Planted demo anomalies (so PIPER has something to discover):
#   - orderly-web-1       — Up 3 days, the web tier
#   - orderly-nginx-1     — Up 3 days, the reverse proxy
#   - orderly-worker-1    — Exited (1) 3 hours ago
#   - orderly-redis-1     — Exited (137) 4 hours ago (OOM — ROOT CAUSE of the
#                                                     worker death)

set -u

# --- root gate ---------------------------------------------------------------
# Real production hosts gate the Docker socket behind root / the docker group.
# The demo deploy user is NOT in that group, so every docker command fails with
# the classic socket permission error unless run under sudo. This is what
# exercises PIPER's reactive-sudo flow (v0.4.3): the read-only snapshot probe
# hits this boundary, PIPER offers elevation, and the whole mutation re-runs
# with `sudo -n`.
if [[ "$(id -u)" -ne 0 ]]; then
  echo "permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock: Get \"http://%2Fvar%2Frun%2Fdocker.sock/v1.45/containers/json\": dial unix /var/run/docker.sock: connect: permission denied" >&2
  exit 1
fi

# --- restart state -----------------------------------------------------------
# `compose restart` drops a marker; `compose ps` reads it so the stack shows
# every service running after a restart. Cleared by scripts/record-demo.sh
# before each take so recordings start from the broken state.
RESTART_MARKER="/tmp/piper-demo-restarted"

# --- inspect helpers --------------------------------------------------------

print_ps_running() {
  cat <<'EOF'
CONTAINER ID   IMAGE                   COMMAND                  CREATED       STATUS         PORTS                   NAMES
a1b2c3d4e5f6   orderly-web:latest      "node dist/server.js"    3 days ago    Up 3 days      0.0.0.0:8080->8080/tcp  orderly-web-1
b2c3d4e5f6a1   nginx:1.27              "nginx -g 'daemon ..."   3 days ago    Up 3 days      0.0.0.0:80->80/tcp      orderly-nginx-1
EOF
}

print_ps_all() {
  cat <<'EOF'
CONTAINER ID   IMAGE                   COMMAND                  CREATED       STATUS                    PORTS                   NAMES
a1b2c3d4e5f6   orderly-web:latest      "node dist/server.js"    3 days ago    Up 3 days                 0.0.0.0:8080->8080/tcp  orderly-web-1
b2c3d4e5f6a1   nginx:1.27              "nginx -g 'daemon ..."   3 days ago    Up 3 days                 0.0.0.0:80->80/tcp      orderly-nginx-1
c3d4e5f6a1b2   orderly-worker:latest   "node dist/worker.js"    3 days ago    Exited (1) 3 hours ago                            orderly-worker-1
d4e5f6a1b2c3   redis:7-alpine          "docker-entrypoint.s..." 3 days ago    Exited (137) 4 hours ago                          orderly-redis-1
EOF
}

print_logs_web() {
  cat <<'EOF'
2026-05-26T11:02:04.121Z [info]  orderly-web booted on :8080
2026-05-26T11:02:04.456Z [info]  config loaded from /etc/orderly/config.yml
2026-05-26T11:02:04.701Z [info]  redis pool initialising (target redis:6379)
2026-05-26T11:02:09.812Z [warn]  redis connect attempt 1 failed: ECONNREFUSED
2026-05-26T11:02:14.815Z [warn]  redis connect attempt 2 failed: ECONNREFUSED
2026-05-26T11:02:19.819Z [warn]  redis connect attempt 3 failed: ECONNREFUSED — entering degraded read-only mode
2026-05-26T11:30:00.001Z [info]  serving HTTP requests, cache backend = degraded
2026-05-26T14:01:55.502Z [warn]  GET /api/dashboard fell back to cold-load path (no cache)
EOF
}

print_logs_worker() {
  cat <<'EOF'
2026-05-26T10:58:01.012Z [info]  orderly-worker booting
2026-05-26T10:58:01.244Z [info]  config loaded, will attach to redis at redis:6379
2026-05-26T10:58:06.301Z [error] redis attach failed: connect ECONNREFUSED 127.0.0.1:6379
2026-05-26T10:58:06.302Z [fatal] cannot operate without cache; exiting with code 1
2026-05-26T10:58:06.310Z [info]  process exiting
EOF
}

print_logs_nginx() {
  cat <<'EOF'
2026-05-26T11:00:00.000Z notice: nginx/1.27 starting
2026-05-26T11:00:00.014Z notice: using the "epoll" event method
2026-05-26T11:00:00.015Z notice: worker process started
EOF
}

print_logs_redis() {
  cat <<'EOF'
2026-05-23T11:00:00.000Z 1:M Redis 7.2.4 (00000000) starting
2026-05-26T07:14:31.502Z 1:M oom-killer: memory cgroup out of memory
2026-05-26T07:14:31.503Z 1:M aborting with exit code 137
EOF
}

print_inspect() {
  local name="$1"
  case "$name" in
    orderly-web-1|orderly-nginx-1)
      cat <<EOF
[
  {
    "Id": "$(echo -n $name | md5sum 2>/dev/null | head -c 12 || echo abcdef012345)abcdef0",
    "Name": "/$name",
    "State": { "Status": "running", "Running": true, "ExitCode": 0, "StartedAt": "2026-05-23T11:02:04Z" },
    "Config": { "Image": "${name%-*}:latest", "Labels": {
      "com.docker.compose.project": "orderly",
      "com.docker.compose.service": "${name%-*-1}"
    }},
    "HostConfig": { "RestartPolicy": { "Name": "unless-stopped" } }
  }
]
EOF
      ;;
    orderly-worker-1)
      cat <<EOF
[
  {
    "Id": "c3d4e5f6a1b2",
    "Name": "/orderly-worker-1",
    "State": { "Status": "exited", "Running": false, "ExitCode": 1, "FinishedAt": "2026-05-26T10:58:06Z" },
    "Config": { "Image": "orderly-worker:latest" }
  }
]
EOF
      ;;
    orderly-redis-1)
      cat <<EOF
[
  {
    "Id": "d4e5f6a1b2c3",
    "Name": "/orderly-redis-1",
    "State": { "Status": "exited", "Running": false, "ExitCode": 137, "FinishedAt": "2026-05-26T07:14:31Z" },
    "Config": { "Image": "redis:7-alpine" }
  }
]
EOF
      ;;
    *)
      echo "Error: No such object: $name" >&2
      exit 1
      ;;
  esac
}

# --- subcommand dispatch -----------------------------------------------------

case "${1:-}" in
  ps)
    shift
    if [[ "${1:-}" == "-a" || "${1:-}" == "--all" ]]; then
      print_ps_all
    else
      print_ps_running
    fi
    exit 0
    ;;
  logs)
    shift
    # ignore --tail N and --since X args — content is fake anyway
    target=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --tail|--since|-n) shift 2 ;;
        --tail=*|--since=*) shift ;;
        -*) shift ;;
        *) target="$1"; shift ;;
      esac
    done
    case "$target" in
      orderly-web-1)    print_logs_web ;;
      orderly-worker-1) print_logs_worker ;;
      orderly-nginx-1)  print_logs_nginx ;;
      orderly-redis-1)  print_logs_redis ;;
      "") echo 'Error: "docker logs" requires exactly 1 argument.' >&2; exit 1 ;;
      *)  echo "Error: No such container: $target" >&2; exit 1 ;;
    esac
    exit 0
    ;;
  inspect)
    shift
    if [[ $# -lt 1 ]]; then
      echo 'Error: "docker inspect" requires at least 1 argument.' >&2
      exit 1
    fi
    print_inspect "$1"
    exit 0
    ;;
  compose)
    # Demo stub for the docker.compose_up / docker.compose_restart flows:
    #   config              → renders the merged compose file (read-only)
    #   ps                  → pretty-printed table (post-restart aware)
    #   ps --format json    → JSON, one row per line, for snapshot/verify
    #   up [-d] [--remove-orphans] [service]   → fakes a successful redeploy
    #   restart [service]   → fakes a stack restart + marks services running
    #   down [service]      → fakes a graceful stop
    # We deliberately ignore -f <path> so any project_dir works.
    shift
    json_format=0
    all_flag=0
    detach_flag=0
    remove_orphans_flag=0
    positional=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -f|--file) shift 2 ;;
        --format) json_format=$([[ "$2" == "json" ]] && echo 1 || echo 0); shift 2 ;;
        --all) all_flag=1; shift ;;
        -d|--detach) detach_flag=1; shift ;;
        --remove-orphans) remove_orphans_flag=1; shift ;;
        --no-color) shift ;;
        --tail) shift 2 ;;
        --tail=*) shift ;;
        *) positional+=("$1"); shift ;;
      esac
    done
    sub="${positional[0]:-}"
    service="${positional[1]:-}"

    case "$sub" in
      config)
        # Print the live compose file from /opt/orderly so it doubles as a
        # plausible merged-view diff in the approval panel.
        cat /opt/orderly/docker-compose.yml
        exit 0
        ;;
      ls)
        # Project-level listing — what docker.compose_ls discovers.
        if [[ -f "$RESTART_MARKER" ]]; then
          cat <<'EOF'
NAME      STATUS       CONFIG FILES
orderly   running(4)   /opt/orderly/docker-compose.yml
EOF
        else
          cat <<'EOF'
NAME      STATUS                  CONFIG FILES
orderly   running(2), exited(2)   /opt/orderly/docker-compose.yml
EOF
        fi
        exit 0
        ;;
      logs)
        # Interleaved per-service logs — what docker.compose_logs tails.
        # Honors an optional service filter; --tail/--no-color are accepted
        # and ignored (content is fixed). Prefixes match compose's format.
        service="${positional[1]:-}"
        emit() { # emit <name> <fn>
          if [[ -z "$service" || "$service" == "${1#orderly-}" || "$service" == "$1" ]]; then
            "$2" | sed "s/^/${1}-1  | /"
          fi
        }
        emit orderly-web print_logs_web
        emit orderly-redis print_logs_redis
        emit orderly-worker print_logs_worker
        emit orderly-nginx print_logs_nginx
        exit 0
        ;;
      ps)
        if [[ -f "$RESTART_MARKER" ]]; then
          # Post-restart state: every declared service is back up.
          if [[ "$json_format" -eq 1 ]]; then
            cat <<'EOF'
{"Name":"orderly-web-1","Service":"web","Image":"registry.example/orderly-web:1.4.2","State":"running","Status":"Up 12 seconds"}
{"Name":"orderly-nginx-1","Service":"nginx","Image":"nginx:1.27-alpine","State":"running","Status":"Up 11 seconds"}
{"Name":"orderly-worker-1","Service":"worker","Image":"registry.example/orderly-worker:1.4.2","State":"running","Status":"Up 10 seconds"}
{"Name":"orderly-redis-1","Service":"redis","Image":"redis:7.4-alpine","State":"running","Status":"Up 12 seconds"}
EOF
            exit 0
          fi
          cat <<'EOF'
NAME                COMMAND                  SERVICE     STATUS         PORTS
orderly-web-1       "node dist/server.js"    web         running        0.0.0.0:8080->8080/tcp
orderly-nginx-1     "nginx -g 'daemon ..."   nginx       running        0.0.0.0:80->80/tcp
orderly-worker-1    "node dist/worker.js"    worker      running
orderly-redis-1     "docker-entrypoint.s..." redis       running        6379/tcp
EOF
          exit 0
        fi
        if [[ "$json_format" -eq 1 ]]; then
          # JSON lines — matches `docker compose ps --format json` v2.
          cat <<'EOF'
{"Name":"orderly-web-1","Service":"web","Image":"registry.example/orderly-web:1.4.2","State":"running","Status":"Up 3 days"}
{"Name":"orderly-nginx-1","Service":"nginx","Image":"nginx:1.27-alpine","State":"running","Status":"Up 3 days"}
{"Name":"orderly-worker-1","Service":"worker","Image":"registry.example/orderly-worker:1.4.2","State":"exited","Status":"Exited (1) 4 hours ago"}
{"Name":"orderly-redis-1","Service":"redis","Image":"redis:7.4-alpine","State":"exited","Status":"Exited (137) 4 hours ago"}
EOF
          exit 0
        fi
        cat <<'EOF'
NAME                COMMAND                  SERVICE     STATUS         PORTS
orderly-web-1       "node dist/server.js"    web         running        0.0.0.0:8080->8080/tcp
orderly-nginx-1     "nginx -g 'daemon ..."   nginx       running        0.0.0.0:80->80/tcp
orderly-worker-1    "node dist/worker.js"    worker      exited (1)
orderly-redis-1     "docker-entrypoint.s..." redis       exited (137)
EOF
        exit 0
        ;;
      restart)
        # `docker compose restart` — the docker.compose_restart mutation
        # (v0.4.4). Cycles containers without recreating them. Marks the
        # stack as restarted so subsequent `ps` (the verify step) reports
        # every service running.
        touch "$RESTART_MARKER" 2>/dev/null || true
        chmod 666 "$RESTART_MARKER" 2>/dev/null || true
        if [[ -n "$service" && "$service" != "restart" ]]; then
          echo " ✔ Container orderly-${service}-1  Started"
        else
          echo " ✔ Container orderly-redis-1     Started"
          echo " ✔ Container orderly-web-1       Started"
          echo " ✔ Container orderly-worker-1    Started"
          echo " ✔ Container orderly-nginx-1     Started"
        fi
        exit 0
        ;;
      up)
        # Simulate a redeploy. If a service is given, scope output to it.
        # Like restart, a successful `up` leaves every service running.
        touch "$RESTART_MARKER" 2>/dev/null || true
        chmod 666 "$RESTART_MARKER" 2>/dev/null || true
        if [[ -n "$service" ]]; then
          echo " ✔ Container orderly-${service}-1  Started"
        else
          echo " ✔ Network orderly_default       Created"
          echo " ✔ Container orderly-redis-1     Started"
          echo " ✔ Container orderly-db-1        Started"
          echo " ✔ Container orderly-web-1       Started"
          echo " ✔ Container orderly-worker-1    Started"
          echo " ✔ Container orderly-nginx-1     Started"
        fi
        exit 0
        ;;
      down)
        if [[ -n "$service" ]]; then
          echo " ✔ Container orderly-${service}-1  Stopped"
          echo " ✔ Container orderly-${service}-1  Removed"
        else
          echo " ✔ Container orderly-nginx-1     Stopped"
          echo " ✔ Container orderly-worker-1    Stopped"
          echo " ✔ Container orderly-web-1       Stopped"
          echo " ✔ Container orderly-db-1        Stopped"
          echo " ✔ Container orderly-redis-1     Stopped"
          echo " ✔ Network orderly_default       Removed"
        fi
        exit 0
        ;;
      *)
        echo "Unsupported docker compose subcommand in the demo stub: $sub" >&2
        exit 2
        ;;
    esac
    ;;
  version|--version|-v)
    echo "Docker version 26.1.4 (demo stub)"
    exit 0
    ;;
  "")
    echo "Usage: docker [OPTIONS] COMMAND"
    exit 1
    ;;
  *)
    echo "Error: unsupported docker subcommand in the demo stub: $1" >&2
    exit 2
    ;;
esac
