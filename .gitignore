tests/fixtures/sshd-docker/keys/piper-e2e-test
tests/fixtures/sshd-docker/keys/piper-e2e-test.pub
tests/fixtures/sshd-docker/host-keys/

# ── Demo host: generated by demo/setup.sh / demo/demo.tape ─────────────
demo/keys/
demo/host-keys/
demo/.piper-demo-data/

# ── /save output (per-user reports written by the TUI) ──────────────────
piper-report-*.md

# ── Local audit & recording artefacts ───────────────────────────────────
.audit/
reports/
*.cast
*.tape.gif

# ── Build / type-check artefacts ────────────────────────────────────────
*.tsbuildinfo
coverage/

# ── Editor / scratch backups ────────────────────────────────────────────
*.bak

# ── AI coding assistants — per-user session state, never commit ─────────
.claude/
.cursor/
.aider*

# ── Knowledge-graph cache (third-party "understand-anything" plugin) ────
.understand-anything/

# ── Repro scripts (developer scratch — not part of the public surface) ──
tools/scripts/repro-*.ts

# Seeded config for demo takes — contains local paths, never committed.
demo/.piper-demo-credentials.json
